// 文件导读
// 所属：packages/codemode/examples/cloudflare/agent，Cloudflare Worker 部署配置。
// 作用：声明 agent Worker 的入口、兼容日期、Durable Object 绑定与迁移；运行逻辑在同目录 src/index.ts。
// 上下游：wrangler deploy 读取本文件；SESSION 绑定本 Worker 的 Session 类，CODEMODE_SANDBOX 通过 script_name 指向独立沙箱 Worker。
// 能力：name/main/compatibility_date 定义 Worker；durable_objects.bindings 注入两个绑定；migrations 创建 Session 的 SQLite 存储类。
// 示例：在 agent 目录运行 `wrangler deploy`；部署前先部署 sandbox Worker，且其 name 与这里的 script_name 一致。
// 阅读顺序：先读 src/index.ts 的 Env 与 fetch，再对照本文件的绑定、迁移和注释。
{
	// 本地 schema 为编辑器提供配置提示，不会在运行时替工具检查参数。
	"$schema": "node_modules/wrangler/config-schema.json",
	// Worker 名称、入口与兼容日期原样保留；此 Worker 承载会话和宿主工具。
	"name": "pi-codemode-agent-example",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-22",
	"durable_objects": {
		// name 是 env 上的键，class_name 是目标 Worker 的导出类名。
		"bindings": [
			{ "name": "SESSION", "class_name": "Session" },
			// The sandbox class lives in its own Worker. `script_name` is what puts scripts in a different
			// isolate; binding a class exported from this Worker would run them on the session's thread.
			// script_name 选择单独部署的沙箱 Worker；省略它而绑定本 Worker 的类会共享会话线程。
			{ "name": "CODEMODE_SANDBOX", "class_name": "CodemodeSandbox", "script_name": "pi-codemode-sandbox" }
		]
	},
	// 迁移声明新建 Session 类的 SQLite 存储能力；示例计数仍只在内存里，没有写 storage。
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }]
}
